# ==============================================================================
# Speech-to-Speech Real-Time Assistant & Voice Cloning Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Network & Port Configuration
# ------------------------------------------------------------------------------
# Port for the background speech-to-speech engine (default: 8081)
PIPELINE_PORT=8081
PIPELINE_HOST=0.0.0.0

# Direct Speech-to-Speech URL for the web client (empty = uses ws://127.0.0.1:8081/v1/realtime)
# SPEECH_TO_SPEECH_URL=ws://127.0.0.1:8081/v1/realtime

# ------------------------------------------------------------------------------
# 2. Default UI & Model Selection
# ------------------------------------------------------------------------------
# Speech Recognition (STT): 'parakeet-tdt', 'whisper', 'faster-whisper', 'paraformer', 'none'
DEFAULT_STT_PROVIDER=parakeet-tdt

# Language Model (LLM) selection:
#   - 'gemini-flash'   (Google Gemini 2.5 Flash · Recommended)
#   - 'gemini-pro'     (Google Gemini 2.0 Pro)
#   - 'openai-mini'    (OpenAI GPT-4o Mini)
#   - 'openai-gpt4o'   (OpenAI GPT-4o)
#   - 'groq-llama'     (Groq Llama 3.3 70B)
#   - 'deepseek-chat'  (DeepSeek-V3)
#   - 'transformers'   (Local PyTorch / CUDA)
DEFAULT_LLM_PROVIDER=gemini-flash
MODEL_NAME=gemini-2.5-flash

# Text-to-Speech (TTS): 'qwen3', 'pocket', 'kokoro', 'chatTTS', 'facebookMMS'
DEFAULT_TTS_PROVIDER=qwen3
DEFAULT_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
DEFAULT_TTS_BACKEND=torch
DEFAULT_TTS_LANGUAGE=auto

# Default reference voice to clone (file name located in assets/reference_sound/)
DEFAULT_REFERENCE_VOICE=khmer_bong_nika_sound.wav

# ------------------------------------------------------------------------------
# 3. Provider API Keys
# (Set the key for the provider you want to use; the system auto-selects the right key)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# Generic fallback key (if using a custom proxy/endpoint)
# LLM_API_KEY=

# ------------------------------------------------------------------------------
# 4. Provider Base URLs (Optional Custom Endpoints / Proxies / Private Gateways)
# (Leave commented out to use official cloud endpoints)
# ------------------------------------------------------------------------------
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# LLM_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Search Tool & Hardware Settings (Optional)
# ------------------------------------------------------------------------------
# SERPER_API_KEY=your_serper_key_for_web_search
# S2S_SANITIZE_CUDA_ENV=1
